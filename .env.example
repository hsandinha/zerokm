# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ═══════════════════════════════════════════
# Mercado Pago — Sistema de Pagamentos
# ═══════════════════════════════════════════
# Obtenha seu token em: https://mercadopago.com.br/developers/panel/app
#
# Para SANDBOX (testes):  TEST-xxxx-xxxx-xxxx-xxxx
# Para PRODUÇÃO:          APP_USR-xxxx-xxxx-xxxx-xxxx
#
# Métodos aceitos automaticamente:
#   ✅ Cartão de Crédito (Visa, Master, Elo, Amex, Hipercard)
#   ✅ Cartão de Débito (Visa, Master, Elo)
#   ✅ PIX
#   ✅ Boleto Bancário
#
MP_ACCESS_TOKEN=your-mercadopago-access-token

# Public Key do Mercado Pago (formato APP_USR-... ou TEST-...).
# Obtenha no mesmo painel do access token: https://mercadopago.com.br/developers/panel/app
# É exposta no browser (NEXT_PUBLIC_*) para permitir tokenização via MP SDK v2.
# Ter a tokenização NO BROWSER é crítico pra reduzir cc_rejected_high_risk,
# porque o token nasce com o device_id e IP reais do usuário.
NEXT_PUBLIC_MP_PUBLIC_KEY=your-mercadopago-public-key

# Assinatura secreta dos Webhooks do Mercado Pago.
# Obtenha em: Painel MP → sua app → Webhooks → "Gerar/Copiar assinatura secreta"
# Usada para validar HMAC-SHA256 em /api/webhooks/mercadopago.
# Se NÃO definida, a validação é desativada (modo compatibilidade) — NÃO recomendado
# em produção porque qualquer pessoa poderia forjar webhooks.
MP_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# ── E-mail (Resend) ──────────────────────────────────────────────
# Chave da API do Resend: https://resend.com/api-keys
# Usada em lib/email/sendEmail.ts para enviar os boletos de renovação.
# SEM esta variável o cron /api/cron/billing NÃO gera nenhum boleto de
# renovação (guard proposital): boleto emitido e não entregue cobraria o
# cliente sem ele receber o documento.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente dos e-mails. O domínio PRECISA estar verificado no Resend
# (Domains → Add Domain → registros SPF/DKIM no DNS), senão a API rejeita.
# Opcional: se ausente, usa "Zero KM <noreply@meuzerokilometro.com.br>".
RESEND_FROM_EMAIL=CNV <noreply@cnv0km.com.br>

# ── Módulo WhatsApp (/dashboard/admin/whatsapp) ───────────────
# Mesmo banco, mesmo Firebase e mesmo Mercado Pago da zerokm — só as contas
# abaixo são novas. Sem elas o módulo sobe, mas cada tela avisa o que falta.

# WhatsApp, Instagram e Messenger (do CNV e das lojas) conectam pelo Chatrun
# Conexão: veja CHATRUN_API_KEY / CHATRUN_CALLBACK_SECRET mais abaixo. Nenhuma
# variável da Meta é necessária.
#
# Só para o número da Vera com credencial própria (formulário da tela IA &
# WABA, que também grava estes valores no banco): o webhook dele é
# /api/webhooks/meta com META_VERIFY_TOKEN. Opcional.
META_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# SMS/RCS — a conta do provedor (Zenvia ou Comtele) é de cada loja e é
# cadastrada na Configuração; nada global aqui. Só para testes locais contra
# um simulador (em produção, deixe vazias):
# ZENVIA_API_URL=
# COMTELE_API_URL=

# Gemini — é a IA que atende no WhatsApp.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# GPT (OpenAI): com LLM_PROVIDER=openai a Vera passa a responder pelo GPT.
# Sem a variável (ou com outro valor) continua o Gemini.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# CNPJá: audiência de campanha por CNPJ.
CNPJA_API_KEY=

# Procob: enriquecimento (CNPJ → sócios → celulares e e-mails). Sem usuário e
# senha o app cai no sandbox público e a tela avisa que os dados são
# fictícios. A conta é liberada por IP e a Vercel não tem IP fixo — as
# chamadas saem por um proxy (FIXIE_URL, lida automaticamente, ou esta).
PROCOB_API_USER=
PROCOB_API_PWD=
PROCOB_PROXY_URL=

# Chave de criptografia das credenciais guardadas no banco pela tela IA & WABA.
APP_ENCRYPTION_KEY=

# Base pública. `siteUrl()` prefere o host que atendeu a requisição; estas são
# o último recurso. ZEROKM_BASE_URL é para onde o Mercado Pago devolve o aviso
# de pagamento gerado pela IA.
ZEROKM_BASE_URL=https://www.cnv0km.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Atendimento das lojas (Chatrun dentro da zerokm) ──────────
# Chatrun Conexão (gateway): WhatsApp, Instagram e Messenger do CNV e das
# lojas são conectados no convite do gateway, e a zerokm não guarda token da
# Meta nem recebe webhook dela. A chave e o segredo saem do /admin do gateway,
# ao cadastrar a plataforma "zerokm" com a callback_url
# https://www.cnv0km.com.br/api/chatrun/eventos.
CHATRUN_API_KEY=
CHATRUN_CALLBACK_SECRET=
# Opcional (padrão https://conexao.chatrun.com.br).
CHATRUN_URL=
# A IA de cada loja usa a chave da própria loja (cadastrada no painel dela).
